# OpenAI-compatible third-party provider.
CODEX_MODEL_PROVIDER=custom
CODEX_PROVIDER_BASE_URL=https://api.example.com/v1
CODEX_PROVIDER_WIRE_API=responses
CODEX_PROVIDER_REQUIRES_OPENAI_AUTH=true
CODEX_MODEL=your-model-name

# Prefer CODEX_API_KEY_FILE for production. The path is resolved on the host
# and mounted into the container by compose.yaml.
CODEX_API_KEY=
CODEX_API_KEY_FILE=/dev/null

# The default interactive mode keeps the terminal session attachable.
CODEX_MODE=interactive
CODEX_PROMPT=
CODEX_CONTINUE_PROMPT=继续
CODEX_SANDBOX=workspace-write
CODEX_APPROVAL_POLICY=on-request

# 0 means retry forever. Delays are exponential and capped.
CODEX_MAX_RETRIES=0
CODEX_RETRY_DELAY_SECONDS=5
CODEX_MAX_RETRY_DELAY_SECONDS=60

# Set to 1 only when intentionally starting a fresh session.
CODEX_RESET_SESSION=0

# Build/deployment paths.
CODEX_WORKSPACE=.
DOCKER_PLATFORM=linux/amd64
