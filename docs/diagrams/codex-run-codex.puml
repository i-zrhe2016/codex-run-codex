@startuml
!theme plain
left to right direction
skinparam componentStyle rectangle
skinparam shadowing false

title Codex Run Codex - Compose deployment

actor "User" as user

package "Docker Compose" {
    component "codex-entrypoint" as entry
    component "codex-supervisor" as supervisor
    component "Codex CLI" as codex
    database "Persistent CODEX_HOME\n(session history + auth)" as home
    folder "Workspace bind mount" as workspace
}

cloud "Third-party\nOpenAI-compatible API" as api

user --> entry : attach / initial prompt
entry --> supervisor : generate provider config
supervisor --> codex : start\non failure: resume --last
codex <--> api : configured base URL\nBearer API key
codex --> home : persist sessions
codex <--> workspace : read / edit files

note right of supervisor
Non-zero API/process exit:
exponential backoff + resume
recovery prompt: 继续
SIGINT/SIGTERM: stop cleanly
end note

@enduml
